# ============================================================
# growthngen-caller — Environment Configuration
# ============================================================
# Copy to .env and fill in values:
#   cp .env.example .env
# NEVER commit .env — it is in .gitignore.
# ============================================================

PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=                    # Will agent ID (agent_9601...)
ELEVENLABS_PHONE_NUMBER_ID=             # phnum_... linked to Twilio number
ELEVENLABS_KATE_AGENT_ID=               # Optional — Kate agent
ELEVENLABS_KATE_PHONE_NUMBER_ID=        # Optional — Kate phone number ID
ELEVENLABS_WEBHOOK_SECRET=              # From ElevenLabs agent settings → Webhooks tab

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=                    # +61... outbound number

# HubSpot
HUBSPOT_API_KEY=
HUBSPOT_OWNER_ID=                       # Liam's HubSpot owner ID (for task creation)
HUBSPOT_HOT_LEAD_WORKFLOW_ID=           # Optional — workflow to enroll hot leads
HUBSPOT_PIPELINE_ID=772428074           # GrowthNGen pipeline
HUBSPOT_DEAL_STAGE_QUALIFIED=1165694817 # "Qualified Opportunity" stage ID

# Anthropic (Claude — for post-call summarisation)
ANTHROPIC_API_KEY=

# Cal.com (for book_meeting tool)
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=5216635            # GrowthNGen Discovery Call event type

# Security — protects POST /calls/trigger from unauthorized use
TRIGGER_API_KEY=                        # Generate a random secret, e.g.: openssl rand -hex 32

# VPS public URL (used in README and ElevenLabs webhook config)
# Format: https://A-B-C-D.sslip.io (replace A-B-C-D with Droplet IP using dashes)
VPS_HOST=
